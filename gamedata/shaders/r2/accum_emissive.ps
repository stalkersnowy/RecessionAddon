#include "common.h"

half4  main  ( p_flat I )  : COLOR
{
#if BLOOM_MODE > 3
 #if BLOOM_MODE > 4
  #if BLOOM_MODE > 5
   return   half4    (1,1,1,0)*5.h;
  #else
   return   half4    (1,1,1,0)*2.0h;
  #endif
 #else
  return   half4    (1,1,1,0)*8.0h;
 #endif
#else
  return   half4    (1,1,1,1)*8.0h;
#endif
}
