[logic]
active = ph_door@blocked

[ph_door@blocked]
locked = true
closed = true
snd_open_start = trader_door_locked
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
on_info = {+agroprom_military_case_have} ph_door@locked
show_tips = false
slider = true

[ph_door@locked]
locked = true
closed = true
snd_open_start = trader_door_locked
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
on_info = {+gar_free_pass} ph_door@open, {+gar_kill_boars_request} ph_door@open, {+sar2_death_18} ph_door@open
show_tips = false
slider = true

[ph_door@open]
locked = true
closed = false
snd_open_start = trader_door_locked
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
show_tips = false
slider = true